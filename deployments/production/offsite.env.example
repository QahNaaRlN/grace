# Install only on the VPS at /opt/grace/shared/secrets/offsite.env, mode 600 (SPEC-0050).
# Never commit a completed copy, put it in a PR, or print it in a job log.
# The access key belongs to a service account that may only put objects into this bucket.
GRACE_OFFSITE_ENDPOINT='https://storage.yandexcloud.net'
GRACE_OFFSITE_REGION='ru-central1'
GRACE_OFFSITE_BUCKET='replace-with-bucket-name'
GRACE_OFFSITE_PREFIX='grace'
GRACE_OFFSITE_ACCESS_KEY_ID='replace-with-static-access-key-id'
GRACE_OFFSITE_SECRET_ACCESS_KEY='replace-with-static-secret-key'
# Public key only; the private key stays with the owner, never on the VPS.
GRACE_OFFSITE_AGE_RECIPIENT='age1replace-with-owner-public-key'
GRACE_OFFSITE_ALERT_TO='owner@example.com'
