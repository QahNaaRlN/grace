# Install only on the VPS at /opt/grace/shared/secrets/email.env, mode 600.
# Never commit a completed copy, put it in a PR, or print it in a job log.
GRACE_AUTH_MODE='email'
GRACE_SMTP_HOST='postbox.cloud.yandex.net'
GRACE_SMTP_PORT='587'
GRACE_SMTP_SECURITY='starttls'
GRACE_SMTP_FROM='Grace <no-reply@graceapp.ru>'
GRACE_SMTP_USERNAME='replace-with-postbox-smtp-username'
GRACE_SMTP_PASSWORD='replace-with-postbox-smtp-password'
GRACE_EMAIL_MONTHLY_BUDGET='1500'
