APP_PORT=8080
DATABASE_URL=postgres://grace:grace@127.0.0.1:55432/grace?sslmode=disable
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_ENV=development
GRACE_AUTH_MODE=development
GRACE_PUBLIC_URL=http://localhost:5173
# For HTTPS Telegram login: GRACE_AUTH_MODE=telegram, APP_ENV=production,
# TELEGRAM_CLIENT_ID and TELEGRAM_CLIENT_SECRET (server environment only).
# Optional AI uses OpenRouter only; remain disabled until separately configured.
GRACE_AI_ENABLED=false
GRACE_STATEMENT_AI_ENABLED=false
# GRACE_AI_MODEL_GROUPS: operator-qualified JSON; see docs/openrouter-document-reading.md.
# OPENROUTER_API_KEY is server-only and is not required for manual finance/imports.
# Receipt photo/PDF manual drafts also need a private server-owned storage directory.
# GRACE_AI_PHOTO_DIR=/absolute/private/directory
